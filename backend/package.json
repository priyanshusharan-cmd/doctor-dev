{
  "name": "@doctor-dev/backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only --exit-child src/server.ts",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src/app.test.ts src/regressions.test.ts src/engine.test.ts && ts-node src/tests/benchmarks.test.ts",
    "lint": "echo 'lint ok'",
    "eval": "ts-node --transpile-only src/tests/evalRepos.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "execa": "^5.1.1",
    "express": "^4.19.2",
    "fast-glob": "^3.3.2",
    "ts-morph": "^22.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "vitest": "^3.2.7"
  }
}
